# ─── Server Configuration ──────────────────────────────────────────────────
NODE_ENV=production
PORT=5000
HOST=0.0.0.0

# ─── Database ─────────────────────────────────────────────────────────────
# This is currently using the existing database URI from .env.mongodb as a placeholder
# In a real production environment, you would use a dedicated production cluster
MONGODB_URI=mongodb+srv://expertuser:ExpertPass123@cluster0.hzlzqfk.mongodb.net/expert-booking-system?retryWrites=true&w=majority

# ─── Security (CRITICAL) ──────────────────────────────────────────────────
# Generated Secure Secret
JWT_SECRET=30a1a2e926a5e1a102b1d4a1c31a1b8981cfb17a17b0bf1847997e4199183b4facc40b36362530f1e1755c398b5cc3a34b876be39cdeb73b08181bbf8d50fb6a
JWT_EXPIRES_IN=7d
BCRYPT_ROUNDS=12

# ─── CORS & URLs ──────────────────────────────────────────────────────────
# Placeholder production domains
FRONTEND_URL=https://expert-booking.vercel.app
MOBILE_URL=https://expert-booking-mobile.vercel.app

# ─── HTTPS ────────────────────────────────────────────────────────────────
ENFORCE_HTTPS=false

# ─── Email (Nodemailer) ───────────────────────────────────────────────────
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=notifications@expertbooking.com
EMAIL_PASS=placeholder-app-password
EMAIL_FROM=Expert Booking <notifications@expertbooking.com>

# ─── File Storage (Cloudinary) ────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=expertbooking
CLOUDINARY_API_KEY=placeholder-api-key
CLOUDINARY_API_SECRET=placeholder-api-secret

# ─── Monitoring & Scaling (Optional) ──────────────────────────────────────
LOG_LEVEL=info

# ─── Business Logic ───────────────────────────────────────────────────────
PLATFORM_COMMISSION_RATE=10
