# ===========================================
# PRODUCTION ENVIRONMENT CONFIGURATION
# ===========================================
# ─── Server Configuration ──────────────────────────────────────────────────
NODE_ENV=production
PORT=5000
HOST=0.0.0.0

# ─── Database ─────────────────────────────────────────────────────────────
# Use MongoDB Atlas string for production
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/expert-booking-prod

# ─── Security (REQUIRED) ──────────────────────────────────────────────────
# Use 'node scripts/generate-jwt.js' to create a secure key
JWT_SECRET=your_32_character_minimum_random_string
JWT_EXPIRES_IN=7d
BCRYPT_ROUNDS=12

# ─── CORS & URLs ──────────────────────────────────────────────────────────
# Replace with your actual production domains
FRONTEND_URL=https://your-app-domain.com
MOBILE_URL=https://your-mobile-domain.com

# ─── HTTPS ────────────────────────────────────────────────────────────────
ENFORCE_HTTPS=true

# ─── Email (Nodemailer) ───────────────────────────────────────────────────
# For Gmail, use an "App Password"
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=noreply@your-domain.com
EMAIL_PASS=your-app-password
EMAIL_FROM=noreply@your-domain.com

# Payment Configuration (SaaS subscriptions only)
STRIPE_SECRET_KEY=sk_live_your-stripe-secret-key
STRIPE_PUBLISHABLE_KEY=pk_live_your-stripe-publishable-key
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret

# File Storage Configuration
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Logging and Monitoring
LOG_LEVEL=info
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id

# Platform Configuration
PLATFORM_COMMISSION_RATE=10

# ===========================================
# DEVELOPMENT ENVIRONMENT CONFIGURATION
# ===========================================

# Uncomment these lines for development only
# NODE_ENV=development
# PORT=5000
# MONGODB_URI=mongodb://localhost:27017/expert-booking
# JWT_SECRET=dev-jwt-secret-key-for-development-only
# FRONTEND_URL=http://localhost:3000
# CORS_ORIGIN=http://localhost:3000
