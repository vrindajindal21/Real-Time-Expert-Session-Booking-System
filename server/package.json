{
  "name": "expert-booking-server",
  "version": "1.0.0",
  "description": "Backend server for Expert Booking System",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "dev": "nodemon index.js",
    "seed": "node seed.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:production": "jest tests/production.test.js --forceExit",
    "generate-jwt": "node scripts/generate-jwt.js",
    "build:production": "node scripts/build-production.js",
    "deploy:staging": "NODE_ENV=staging npm run build:production",
    "deploy:production": "NODE_ENV=production npm run build:production",
    "health": "curl -f http://localhost:5000/api/health || exit 1"
  },
  "dependencies": {
    "@bull-board/api": "^8.0.1",
    "@bull-board/express": "^8.0.1",
    "@socket.io/redis-adapter": "^8.3.0",
    "bcryptjs": "^2.4.3",
    "bullmq": "^5.79.1",
    "cloudinary": "^2.9.0",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^8.3.2",
    "helmet": "^8.1.0",
    "hpp": "^0.2.3",
    "ioredis": "^5.11.1",
    "joi": "^17.11.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^8.0.3",
    "morgan": "^1.10.1",
    "multer": "^2.1.1",
    "nodemailer": "^8.0.5",
    "redis": "^5.12.1",
    "socket.io": "^4.7.4",
    "stripe": "^22.0.2",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "mongodb-memory-server": "^9.1.3",
    "nodemon": "^3.0.2",
    "supertest": "^6.3.3"
  },
  "keywords": [
    "nodejs",
    "express",
    "mongodb",
    "socket.io",
    "booking"
  ],
  "author": "",
  "license": "MIT"
}
